      });
    });

      $(document).ready(function() {
        $('.mega-cat-dropdown li.navPages-item').hover(function() {
          $(this).find('.flyout-pagination-container.bottom a.navPages-action.paginator').removeClass('active-page').addClass('inactive-page');
